# Copy to .env and fill in. Never commit .env.

# --- Provider (these three are the ONLY difference between local and hosted) ---
# OpenRouter (hosted): LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=<your key>  LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# Ollama (local):      LLM_BASE_URL=http://localhost:11434/v1/   LLM_API_KEY=ollama      LLM_MODEL=gemma3:1b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-lightning:free

# --- Switches ---
LLM_STUB=0            # 1 = skip the model, return a fixed valid answer (zero calls, zero quota)
LLM_ENABLED=true      # false = kill switch: no model calls, instant safe fallback

# --- Reliability ---
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2     # our retries on timeout / 429 / 5xx; the SDK's own retries are set to 0
LLM_RETRY_BASE_SECONDS=1

# --- Prompt + cost ---
PROMPT_VERSION=triage-v1
LLM_PRICE_IN_PER_M=0  # USD per 1M input tokens (0 for free models / Ollama)
LLM_PRICE_OUT_PER_M=0 # USD per 1M output tokens
